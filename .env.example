# Copiez ce fichier en .env.local puis remplissez les valeurs.
# Supabase → Project Settings → API (ou « API Keys »).

# URL du projet, ex. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Clé PUBLIQUE (sb_publishable_…) : lecture de la carte et connexion du personnel.
# Elle peut être vue sans risque, les droits sont limités par la base (RLS).
SUPABASE_PUBLISHABLE_KEY=

# Clé SECRÈTE (sb_secret_… ou ancienne clé service_role).
# ⚠️ Serveur uniquement : jamais de préfixe NEXT_PUBLIC_, jamais dans le code, jamais sur GitHub.
# Sur Vercel : Settings → Environment Variables.
SUPABASE_SECRET_KEY=
